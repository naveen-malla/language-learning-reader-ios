{
  "rewrites": [{ "source": "/((?!dict/|assets/|sw.js|workbox-).*)", "destination": "/index.html" }],
  "headers": [
    { "source": "/dict/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] },
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
  ]
}
